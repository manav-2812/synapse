# ============================================================
# SYNAPSE Frontend — environment variable template
# Copy to .env and set real values. NEVER commit .env.
# ============================================================

# Base URL of the FastAPI backend (must include /api/v1).
# In local dev the backend defaults to http://localhost:8000/api/v1.
# For a deployed instance point this at your Render / Railway URL + /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# OAuth 2.0 Client IDs (Optional - for Google / Microsoft Sign-In)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback/microsoft
